# Giá trị dev giả — không có secret thật. `pnpm dev` tự sao thành .env.local nếu chưa có.
# Mọi biến khác của SRS 8.1 đều có mặc định dev; chỉ đặt ở đây khi cần đổi.

APP_ENV=dev

# Postgres (compose: cổng host 5433). DATABASE_URL là kết nối TRỰC TIẾP — migrate dùng nó.
POSTGRES_USER=edupilot
POSTGRES_PASSWORD=edupilot-dev
POSTGRES_DB=edupilot
DATABASE_URL=postgres://edupilot:edupilot-dev@postgres:5432/edupilot?sslmode=disable

# PgBouncer (chỉ trong mạng compose, cổng 6432): kết nối runtime của gateway/worker.
# PGBOUNCER_STATS_USER phải trùng `stats_users` trong deploy/pgbouncer/pgbouncer.ini.
PGBOUNCER_URL=postgres://edupilot:edupilot-dev@pgbouncer:6432/edupilot?sslmode=disable
PGBOUNCER_STATS_USER=pgb_stats
PGBOUNCER_STATS_PASSWORD=pgbouncer-stats-dev

# Redis (compose: cổng host 6380)
REDIS_URL=redis://redis:6379/0

# JWT HS256 — ≥ 32 byte. Giá trị mẫu này bị từ chối khi APP_ENV=production.
JWT_SECRET_KEY=edupilot-dev-jwt-secret-key-change-me-0001

# Mã hoá khoá API của nhà cung cấp LLM (AES-256-GCM): đúng 32 byte, base64. Giá trị mẫu này CHỈ cho dev (giải ra
# "edupilot-dev-encryption-key-32by"); production tự sinh: `head -c 32 /dev/urandom | base64`. Đổi khoá = khoá cũ trong DB không đọc được.
APP_ENCRYPTION_KEY=ZWR1cGlsb3QtZGV2LWVuY3J5cHRpb24ta2V5LTMyYnk=

# Cổng LLM (FEAT-llm-gateway). Cấu hình nhà cung cấp thật nằm ở /settings/llm (DB, khoá mã hoá); các biến dưới đây là
# mặc định vận hành + đường dự phòng khi DB chưa có nhà cung cấp nào. Để trống khoá = không dùng. KHÔNG điền khoá thật vào repo.
LLM_PROVIDER=fake
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MAX_CONCURRENCY=10
LLM_BATCH_SHARE=0.5
LLM_QUEUE_MAX=200
LLM_QUEUE_WAIT_MAX=10s
LLM_REQUEST_TIMEOUT=30s
LLM_BREAKER_FAILS=5
LLM_BREAKER_OPEN=30s
LLM_DEFAULT_RPM=60
LLM_DEFAULT_TPM=100000
LLM_EMBED_DIMS=1536
# provider giả cho dev/test/tải: độ trễ min-max ms (0-0 cho test; 5000-15000 cho tải), tỉ lệ lỗi 0–1, khoá hợp lệ (rỗng = mọi khoá)
FAKE_LLM_LATENCY=0-0
FAKE_LLM_ERROR_RATE=0
FAKE_LLM_VALID_KEY=
LLM_REPLAY_DIR=

# Phiên đăng nhập (US-P2-02): access JWT ngắn + refresh xoay vòng trong cookie httpOnly ep_rt; hạn tuyệt đối của một phiên.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=336h
SESSION_ABSOLUTE_TTL=720h
COOKIE_DOMAIN=

# HTTP
CORS_ORIGINS=http://localhost:3000,https://localhost
NEXT_PUBLIC_API_URL=https://localhost

# Object storage (dev → MinIO: API 9000, console 9001). Bucket do gateway tạo khi APP_ENV ≠ production.
BLOB_ENDPOINT=minio:9000
BLOB_PUBLIC_ENDPOINT=localhost:9000
BLOB_BUCKET=edupilot
BLOB_ACCESS_KEY=edupilot-dev
BLOB_SECRET_KEY=edupilot-dev-secret
BLOB_USE_SSL=false

# Mail (dev → Mailpit: SMTP 1025, UI 8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduPilot <no-reply@edupilot.local>
SMTP_TLS=none
MAIL_SEND_TIMEOUT=10s
# Gốc dựng liên kết trong thư (xác minh, đặt lại mật khẩu, mời). Production bắt buộc https.
APP_PUBLIC_URL=https://localhost
VERIFY_TOKEN_TTL=24h
RESET_TOKEN_TTL=30m

# Chờ / khoá / giới hạn chống dò mật khẩu (FEAT-account-security SRS 4.2.2, 8.1). Giá trị dưới đây là mặc định.
# Sai 5 lần ⇒ chờ 2, 4, 8, 16, 32 giây; sai lần thứ 10 ⇒ khoá LOCKOUT_DURATION và gửi thư account_locked.
LOCKOUT_BACKOFF_FROM=5
LOCKOUT_LOCK_AT=10
LOCKOUT_DURATION=15m
AUTH_LOGIN_IP_PER_MIN=10
AUTH_LOGIN_IP_FAIL_PER_15M=30
AUTH_REGISTER_IP_PER_HOUR=5
AUTH_FORGOT_IP_PER_HOUR=5
AUTH_FORGOT_EMAIL_PER_HOUR=3
AUTH_TOKEN_IP_PER_MIN=20
AUTH_REFRESH_IP_PER_MIN=60
AUTH_CHANGE_PW_FAIL_PER_10M=5
AUTH_RESEND_SECONDS=60
INVITE_TOKEN_TTL=72h

# Dữ liệu mẫu (US-P2-12): `pnpm seed` hoặc `SEED_ON_EMPTY_DB=true pnpm dev` dựng 2 lớp × 30 sinh viên bằng chính API thật.
# Mật khẩu mặc định của 60 tài khoản mẫu (qua chính sách mật khẩu); giá trị dev giả, không bí mật thật. Seed bị chặn khi APP_ENV=production.
SEED_ON_EMPTY_DB=false
SEED_DEFAULT_PASSWORD=Edupilot#Seed-2026
SEED_RNG=20261029

# Chạy HAI stack dev trên một máy (ví dụ dev + QC): `EP_PORT_OFFSET=100 pnpm dev` (project edupilot100, HTTPS 543, Mailpit 8125, Postgres 5533…).
# Dừng đúng stack đó bằng cùng biến: `EP_PORT_OFFSET=100 pnpm dev:down -v`. Cổng riêng lẻ: EP_PORT_{POSTGRES,REDIS,MINIO,MINIO_CONSOLE,SMTP,MAILPIT,HTTP,HTTPS,FRONTEND}.
EP_PORT_OFFSET=0

# Máy chấm code (US-PE-02, D58). Chỉ worker gọi judge (mạng nội bộ judge_net); gateway không.
# JUDGE_TOKEN ≥ 16 ký tự, tự đặt (giá trị dev giả). Worker thoát 1 nếu thiếu / ngắn.
JUDGE_TOKEN=dev-judge-token-change-me-0123
JUDGE_PARALLELISM=2
# Phải ≥ JUDGE_PARALLELISM × (512 + 256) + 512 MiB (worker kiểm lúc khởi động: P=2 → 2g, P=4 → 3584m). Dùng chung cho mem_limit của container judge.
JUDGE_MEM_LIMIT=2g
JUDGE_CPUS=2
# Đúng MỘT bản worker đặt true. Colima arm64: JUDGE_EXTRA_ARGS=-no-seccomp (D58); KHÔNG đặt trên amd64.
JUDGE_CONSUMER=true
JUDGE_EXTRA_ARGS=
JUDGE_LEASE=30s
JUDGE_LEASE_RENEW=10s
JUDGE_CLAIM_IDLE=10m

# Nhập test bằng zip (US-PE-03): giới hạn nén / giải nén (đếm khi đọc, chống zip bomb).
EXAM_TESTZIP_MAX_BYTES=10485760
EXAM_TESTZIP_MAX_UNCOMPRESSED=52428800
