{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "puppeteerScript": "./benchmarks/lighthouse/auth-ep.cjs",
      "puppeteerLaunchOptions": { "args": ["--no-sandbox", "--headless=new", "--ignore-certificate-errors"] },
      "settings": { "chromeFlags": "--no-sandbox --headless=new --ignore-certificate-errors", "onlyCategories": ["performance"] }
    },
    "upload": { "target": "filesystem", "outputDir": "./benchmarks/.lighthouse-raw" }
  }
}
