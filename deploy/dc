#!/bin/sh
# docker compose của VPS: `deploy/dc up -d --build --wait`, `deploy/dc logs -f gateway`, `deploy/dc ps`. Luôn bật profile `ingest` (docling).
cd "$(dirname "$0")/.." && exec docker compose --env-file .env.local -f docker-compose.local.yml -f deploy/vps.compose.yml -p edupilot --profile ingest "$@"
