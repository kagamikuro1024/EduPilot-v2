{
	local_certs
	admin off
}

(gateway_upstream) {
	dynamic a gateway 8080 {
		refresh 2s
	}
	lb_policy round_robin
	lb_try_duration 5s
	lb_try_interval 250ms
	flush_interval -1
	transport http {
		dial_timeout 2s
		response_header_timeout 35s
	}
}

localhost {
	# Log truy cập CHỈ che liên kết bí mật (FEAT-account-security US-P2-04 AC13): `?token=…` của /verify-email, /reset-password và
	# `/invite/<token>` không bao giờ vào log; US-P2-09: mã tham gia `/join/<mã>` cũng che (`/join/REDACTED`). Giá trị đổi thành REDACTED trước khi ghi.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp (token=|/invite/|/join/)[A-Za-z0-9_-]+ ${1}REDACTED
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	# readyz đi riêng, KHÔNG bị đánh dấu lỗi thụ động: 503 NOT_READY của nó là trả lời đúng khi Postgres/Redis đang tắt,
	# không phải bản gateway hỏng; nếu đánh dấu thì Caddy loại cả hai bản thêm `fail_duration` sau khi phụ thuộc đã sống lại.
	handle /api/v1/readyz {
		reverse_proxy {
			import gateway_upstream
		}
	}

	@api path /healthz /api/*
	handle @api {
		# không có `encode` ở nhánh này: JSON nhỏ và text/event-stream không bị nén / đệm
		reverse_proxy {
			import gateway_upstream
			# Chỉ lỗi KẾT NỐI (bản đã chết / từ chối) mới loại upstream. KHÔNG dùng `unhealthy_status 503`: mọi 503 của ứng dụng
			# (Redis/DB tắt…) là câu trả lời hợp lệ, nếu tính là lỗi thì Caddy loại cả hai bản rồi tự trả 503 rỗng (BUG-PG-1).
			fail_duration 10s
			max_fails 1

			# Gateway đang tắt (cửa sổ drain, cổng còn mở) trả 503 NOT_READY kèm `X-EP-Draining` cho mọi đường trừ readyz:
			# chỉ response mang dấu này mới bị chặn lại, thử NGAY lần nữa (AC6) và lần thử đó tính 503 là lỗi để loại bản
			# đang tắt khỏi vòng xoay. Các 503 khác của ứng dụng không đi qua đây — tới client nguyên vẹn.
			@draining {
				status 503
				header X-EP-Draining 1
			}
			handle_response @draining {
				reverse_proxy {
					import gateway_upstream
					fail_duration 10s
					max_fails 1
					unhealthy_status 503
				}
			}
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy frontend:3000
	}
}
